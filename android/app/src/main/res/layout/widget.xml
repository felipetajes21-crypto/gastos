<?xml version="1.0" encoding="utf-8"?>
<!-- sem fundo: só a caixa "Digite o gasto…" e o microfone, por cima do papel de parede -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/campo"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:background="@drawable/widget_campo"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:text="@string/widget_campo"
        android:textColor="#E6FFFFFF"
        android:textSize="16sp"
        android:shadowColor="#66000000"
        android:shadowRadius="4"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/mic"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_botao"
        android:contentDescription="@string/falar"
        android:padding="14dp"
        android:src="@drawable/ic_mic" />
</LinearLayout>
